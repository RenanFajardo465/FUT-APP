# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). A chave publishable/anon é pública por design;
# a segurança vem das políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Nome do app no manifest/título (opcional, padrão "Pelada")
NEXT_PUBLIC_APP_NAME=Pelada
